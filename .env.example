APP_NAME=Rancho
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_TIMEZONE_DISPLAY=Europe/Moscow

# Админ для сидера (если UserSeeder использует env)
ADMIN_EMAIL=admin@rancho.com
ADMIN_PHONE=+7 (999) 111-11-11
ADMIN_PASSWORD=admin

MAIL_MAILER=smtp
MAIL_HOST=smtp.yandex.ru
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# База
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rancho_db
DB_USERNAME=postgres
DB_PASSWORD=

# PostGIS
# psql -U postgres -d rancho_db -c "CREATE EXTENSION IF NOT EXISTS postgis;"

# Фронтенд
VITE_MAPBOX_TOKEN=
VITE_YANDEX_GEOCODER_KEY=

# Яндекс Статик API (скриншот карты в Telegram-боте)
YANDEX_STATIC_API_KEY=

# Платежи
PAYMENT_DRIVER=fake
PAYMASTER_MERCHANT_ID=
PAYMASTER_SECRET_KEY=
TINKOFF_TERMINAL_KEY=
TINKOFF_SECRET_KEY=
TINKOFF_API_URL=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=

# Inertia SSR
INERTIA_SSR_ENABLED=false
INERTIA_SSR_URL=http://127.0.0.1:13714

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Яндекс Метрика
YANDEX_METRIKA_ID=

# Почта (локально)
MAIL_MAILER=log

# ИИ помочник (Гигачат)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_DEFAULT_MODEL=GigaChat

HONEYPOT_ENABLED=true
HONEYPOT_NAME=my_name
HONEYPOT_VALID_FROM=valid_from
HONEYPOT_SECONDS=1
